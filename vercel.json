{
  "crons": [
    {
      "path": "/api/cron-ipo",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:route(company-disclosures|company-history|report-evidence|research-portfolios|fundamentals|scorecards|option-chain|spec-paper|spec-paper-cycle|signals|stock-analysis)",
      "destination": "/api/research?route=:route"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/premarket.js": {
      "maxDuration": 60
    },
    "api/scheduled-premarket.js": {
      "maxDuration": 60
    },
    "api/research.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "maxDuration": 30
    },
    "api/shared-paper.ts": {
      "maxDuration": 60
    },
    "api/scheduled-paper.ts": {
      "maxDuration": 60
    }
  }
}
