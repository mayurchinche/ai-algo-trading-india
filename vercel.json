{
  "crons": [
    {
      "path": "/api/cron-ipo",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  }
}
